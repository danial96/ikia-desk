{
  "expo": {
    "name": "IKIA Desk",
    "slug": "ikia-desk",
    "scheme": "ikiadesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ikiatech.desk",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.ikiatech.desk",
      "adaptiveIcon": {
        "backgroundColor": "#04252b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04252b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "IKIA Desk needs your photos so you can send them in chats and tasks.",
          "cameraPermission": "IKIA Desk needs the camera so you can take and send a photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "IKIA Desk uses the microphone to record voice messages."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0b6b73",
          "defaultChannel": "messages"
        }
      ],
      "expo-dev-client",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "IKIA Desk does not use the camera in calls.",
          "microphonePermission": "IKIA Desk uses the microphone for voice calls and voice messages."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://desk.ikiatech.com",
      "router": {},
      "eas": {
        "projectId": "d973f9f9-5718-45b5-bc8b-b33e7f4bb2d3"
      }
    },
    "owner": "huzaifa36"
  }
}
